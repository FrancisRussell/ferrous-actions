{
  "name": "ferrous-actions",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub actions for Rust written in Rust and compiled to WebAssembly",
  "scripts": {
    "build": "wasm-pack build -t nodejs --out-name lib --no-pack && esbuild --bundle --platform=node --format=cjs --conditions=import --minify pkg/lib.js --outfile=dist/index.js --log-override:duplicate-object-key=silent && cp -a pkg/lib_bg.wasm dist/ && cp -a phase-wrappers/* dist",
    "format": "cargo fmt",
    "format-check": "cargo fmt -- --check",
    "lint": "cargo clippy",
    "test": "NODE_PATH=node_modules wasm-pack test --node -- --no-default-features --features node_bindings",
    "generate-licenses": "generate-license-file -i package.json -o LICENSE-3RD-PARTY-JAVASCRIPT --overwrite --ci --no-spinner"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancisRussell/ferrous-actions-dev.git"
  },
  "keywords": [
    "actions",
    "rust",
    "github",
    "wasm"
  ],
  "author": "Francis Russell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FrancisRussell/ferrous-actions-dev/issues"
  },
  "homepage": "https://github.com/FrancisRussell/ferrous-actions-dev",
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "generate-license-file": "^4.1.1",
    "wasm-pack": "^0.14.0"
  }
}
